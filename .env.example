# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by /api/update-price so it keeps working even if RLS
# policies are tightened later. Optional: falls back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — password required to unlock edit mode (login page / session cookie)
ADMIN_PASSWORD=your-admin-password
