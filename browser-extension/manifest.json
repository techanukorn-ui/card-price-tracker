{
  "manifest_version": 3,
  "name": "Card Price Tracker - SNKRDUNK Auto Update",
  "version": "1.0.3",
  "description": "อ่านราคาขายจริงจาก SNKRDUNK ด้วยเบราว์เซอร์จริงของคุณ แล้วส่งกลับไปอัปเดตให้ card-price-tracker อัตโนมัติ",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://snkrdunk.com/*",
    "https://card-price-tracker-ten.vercel.app/*",
    "http://localhost:3000/*",
    "https://api.frankfurter.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://card-price-tracker-ten.vercel.app/*", "http://localhost:3000/*"],
      "js": ["webapp-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
